# Optional fine-grained token with read-only access to selected repositories.
GITHUB_TOKEN=

# Required for the remote Streamable HTTP deployment.
DATABASE_URL=
MCP_BEARER_TOKEN=
AGENT_TENANT_ID=primary
PUBLIC_HOST=localhost:3000
PORT=3000

# Fixed GitHub repository and fine-grained token with Actions read/write permission.
# The token is a Render secret only; never expose it to clients or logs.
GITHUB_REPOSITORY=owner/repository
GITHUB_ACTIONS_TOKEN=
